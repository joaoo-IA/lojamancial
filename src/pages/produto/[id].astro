---
import Base from '../../layouts/Base.astro';
import { carregarCatalogo, publicados, dinheiro } from '../../lib/catalogo';
export function getStaticPaths() { return publicados(carregarCatalogo()).map(p => ({ params: { id: p.id }, props: { p } })); }
const { p } = Astro.props;
---
<Base title={p.nome}><div class="shell page-heading"><a href="/">Voltar à coleção</a></div><article class="product shell"><div class="product-art"><img src={p.foto} alt={p.fotoAlt} width="800" height="900" /><span class="art-label">IMAGEM ILUSTRATIVA</span></div><div class="product-details"><p class="eyebrow">{p.categoria}</p><h1 style="font-size:clamp(2rem,4vw,3rem)">{p.nome}</h1><p class="price">{dinheiro(p.precoCentavos)}</p><p class="description">{p.descricao}</p><p>Inclui: {p.pecasIncluidas}.</p><p class="description">Variações ilustrativas: {p.variacoes.map(v => v.cor + ' / ' + v.tamanho).join(', ')}.</p><p class="demo-note">Prova administrativa. Pedidos e carrinho serão desenvolvidos após a revisão desta etapa.</p></div></article></Base>
