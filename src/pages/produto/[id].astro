---
import Base from '../../layouts/Base.astro';import Gallery from '../../components/Gallery.astro';import MeasureTable from '../../components/MeasureTable.astro';import {guias} from '../../lib/conteudo';import {carregarCatalogo,publicados,dinheiro} from '../../lib/catalogo';export function getStaticPaths(){return publicados(carregarCatalogo()).map(p=>({params:{id:p.id},props:{p}}));}const {p}=Astro.props;const guia=guias().find(g=>g.id===p.guiaMedidasId);
---
<Base title={p.nome}><div class="shell breadcrumb"><a href="/#colecao">A coleção</a><span aria-hidden="true">/</span><span>{p.nome}</span></div><article class="shell product-detail"><Gallery produto={p}/><div class="product-info"><p class="eyebrow">{p.categoria}</p><h1>{p.nome}</h1><p class="detail-price">{dinheiro(p.precoCentavos)}</p><p class="lead-copy">{p.descricao}</p><p class="included">Inclui: {p.pecasIncluidas}.</p><div class="detail-divider"><h2>Variações ilustrativas</h2><ul class="variant-list">{p.variacoes.map(v=><li>{v.cor} <span>·</span> {v.tamanho}</li>)}</ul></div><p class="notice-inline">Esta coleção é uma demonstração. Pedidos ainda não estão disponíveis.</p><details open><summary>Sobre a peça</summary><p>{p.descricao}</p></details><details><summary>Entrega e retirada</summary><p>As condições serão definidas antes do lançamento. Nenhum pedido é realizado nesta prévia.</p></details>{guia&&<details><summary>Guia de medidas</summary><MeasureTable guia={guia}/></details>}</div></article><section class="shell section-space"><a class="button secondary" href="/#colecao">Continuar explorando</a></section></Base>
