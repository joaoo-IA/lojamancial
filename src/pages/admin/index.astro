---
import { isPreviewDemo } from '../../lib/preview';
const demo=isPreviewDemo();
const local = import.meta.env.DEV && import.meta.env.CMS_LOCAL_BACKEND === 'true';
---
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>Painel · LOJA</title>{demo && <meta http-equiv="Content-Security-Policy" content="default-src 'self'; connect-src 'self' blob:; img-src 'self' blob: data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; form-action 'none'"/>}<style is:global>html{height:100%}body{margin:0;font-family:Arial,Helvetica,sans-serif;height:100vh;height:100dvh;display:flex;flex-direction:column;overflow:hidden}#cms-toolbar{position:relative;z-index:1;flex-shrink:0;background:#191919;color:white;padding:12px 20px;font-size:14px;display:flex;gap:20px;justify-content:space-between;flex-wrap:wrap}#cms-toolbar a{color:white}#cms-toolbar p{margin:0;color:inherit}#cms-error{padding:32px}/* O editor absoluto do Decap precisa de uma altura definida abaixo da barra, inclusive quando ela quebra linhas. */#nc-root{position:relative;z-index:0;flex:1;min-height:0;overflow:auto}
/* Marcadores de componentes da distribuição Decap fixada; não usar hashes gerados. */
@media(max-width:800px){
 #nc-root [class*="-EditorContainer"]{min-width:0;width:100%;padding-top:0;display:flex;flex-direction:column}
 #nc-root [class*="-ToolbarContainer"]{position:relative;min-width:0;width:100%;height:auto;flex-shrink:0;flex-wrap:wrap}
 #nc-root [class*="-ToolbarSection"]{min-width:0;height:auto;min-height:48px;flex-wrap:wrap}
 #nc-root [class*="-ToolbarSectionBackLink"]{flex-basis:100%}
 #nc-root [class*="-ToolbarSectionMain"]{flex:1;gap:8px}
 #nc-root [class*="-Editor "]{position:relative;top:auto;flex:1;min-height:0;height:auto}
 #nc-root [class*="-ControlHint"]{overflow-wrap:anywhere}
}
</style></head><body><div id="cms-toolbar"><p>{demo ? 'PAINEL DEMONSTRATIVO · alterações só nesta aba · recarregar restaura os exemplos · não publica a vitrine' : local ? 'MODO LOCAL · grava arquivos neste computador · não publica no Cloudflare' : 'LOJA · Administração · salvar inicia a publicação, mas não confirma conclusão'}</p><nav><a href="/publicacao/" target="_blank" rel="noreferrer">Publicações</a> · <a href="/" target="_blank" rel="noreferrer">Ver vitrine</a> · <a href="/administracao/" target="_blank" rel="noreferrer">Ajuda</a></nav></div><div id="cms-error" role="alert" hidden>Não foi possível carregar o painel. Confira a conexão e recarregue a página.</div><div id="nc-root"></div><script is:inline>window.CMS_MANUAL_INIT = true;</script><script is:inline src="/vendor/decap-cms.js" onerror="document.getElementById('cms-error').hidden=false"></script><script is:inline>
(async () => {
 if (!window.CMS) return;
 try {
  const response = await fetch('/admin/config.json', {cache:'no-store'});
  if (!response.ok) throw new Error('config');
  const config = await response.json();
  if (config.backend.name === 'github' && config.backend.base_url.includes('configurar-endereco.invalid')) { const message = document.getElementById('cms-error'); message.hidden = false; message.textContent = 'O painel aguarda a configuração do endereço oficial e do acesso GitHub. A vitrine pode ser publicada primeiro; consulte docs/configuracao-cloudflare.md no repositório.'; return; }
  if (config.backend.name === 'test-repo') {
    const seedResponse = await fetch('/admin/demo-seed.json', {cache:'no-store', credentials:'omit'});
    if (!seedResponse.ok) throw new Error('seed');
    const seed = await seedResponse.json();
    window.repoFiles = {};
    const put = (path, content) => {
      const parts=path.split('/'); let folder=window.repoFiles;
      while(parts.length>1){const key=parts.shift();folder=folder[key]||(folder[key]={});}
      folder[parts[0]]={path,content};
    };
    seed.files.forEach(file=>put(file.path,file.content));
    // O test-repo lista pastas pela chave completa e lê arquivos pela árvore.
    config.collections.filter(collection=>collection.folder).forEach(collection=>{
      window.repoFiles[collection.folder]=collection.folder.split('/').reduce((tree,key)=>tree[key],window.repoFiles);
    });
    await Promise.all(seed.media.map(async media=>{
      const r=await fetch(media.url,{credentials:'omit'});
      if(!r.ok)throw new Error('media');
      const blob=await r.blob();
      put(media.path,{path:media.path,fileObj:new File([blob],media.path.split('/').pop(),{type:blob.type}),
        toString:()=>media.url});
    }));
  }
  window.CMS.init({config});
 } catch { document.getElementById('cms-error').hidden=false; }
})();
</script></body></html>
