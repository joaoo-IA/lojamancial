---
import '../styles/global.css';
import { buildInfo } from '../lib/publicacao';
interface Props { title: string; description?: string }
const { title, description = 'Prova de administração da loja. Produtos e imagens ilustrativos.' } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="robots" content="noindex, nofollow" /><title>{title} · LOJA</title><link rel="icon" href="/favicon.svg" type="image/svg+xml" /></head>
<body>
<a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
<div class="notice">EM DESENVOLVIMENTO · PRODUTOS ILUSTRATIVOS · SEM VENDAS</div>
<header class="header shell"><a class="wordmark" href="/">LOJA<span>movimento & cotidiano</span></a><nav aria-label="Navegação principal"><a href="/#produto">A coleção</a><a href="/publicacao/">Publicações</a><a class="admin-link" href="/admin/">Administrar <span aria-hidden="true">＋</span></a></nav></header>
<main id="conteudo"><slot /></main>
<footer class="footer shell"><div><a class="wordmark" href="/">LOJA</a><p>O começo de uma nova coleção.</p></div><div><p>Prova funcional da administração</p><a href="/publicacao/">Versão ativa: <code>{buildInfo.commit.slice(0, 8)}</code></a></div></footer>
</body></html>
