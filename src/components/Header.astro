---
import {loja} from '../lib/conteudo';const info=loja();
---
<header class="site-header"><div class="shell header-row"><a class="brand" href="/" aria-label={info.nome+' — início'}>{info.nome}<span>{info.subtitulo}</span></a><nav class="desktop-nav" aria-label="Navegação principal"><a href="/#colecao">A coleção</a><a href="/demonstracao/#categorias">Categorias</a><a href="/demonstracao/#medidas">Medidas</a></nav><button class="menu-trigger" type="button" aria-controls="menu-movel" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg><span>Menu</span></button></div></header>
<dialog id="menu-movel" class="mobile-menu"><div class="menu-head"><span class="eyebrow">Navegue</span><button type="button" data-fechar>Fechar <span aria-hidden="true">×</span></button></div><nav aria-label="Navegação móvel"><a href="/#colecao">A coleção</a><a href="/demonstracao/#categorias">Categorias</a><a href="/demonstracao/#medidas">Guia de medidas</a><a href="/demonstracao/">Conheça a base</a></nav><p>Peças que acompanham o seu movimento.</p></dialog>
<script>const trigger=document.querySelector<HTMLButtonElement>('.menu-trigger');const dialog=document.querySelector<HTMLDialogElement>('#menu-movel');trigger?.addEventListener('click',()=>{dialog?.showModal();trigger.setAttribute('aria-expanded','true');});dialog?.querySelector('[data-fechar]')?.addEventListener('click',()=>dialog.close());dialog?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>dialog.close()));dialog?.addEventListener('close',()=>{trigger?.setAttribute('aria-expanded','false');trigger?.focus();});</script>
